<?xml version="1.0" encoding="utf-8"?>
<!--
    Slip K. 108dp adaptive canvas. The glyph is drawn at full size in the group below and scaled to 80%
    about the center: unscaled, its tips reach ~38dp from the center, past the 33dp radius of the 66dp
    safe zone, so a circular mask would clip them. Also used as the monochrome (themed) layer and as the
    splash icon. Lower scaleX/scaleY for more padding, raise for less.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- stem, upper piece -->
        <path
            android:fillColor="#0C0E14"
            android:pathData="M38.5,24 A5.5,5.5 0 0,1 49.5,24 L49.5,30.28 L38.5,36.78 Z" />
        <!-- stem, lower piece -->
        <path
            android:fillColor="#0C0E14"
            android:pathData="M38.5,71.22 L49.5,77.72 L49.5,84 A5.5,5.5 0 0,1 38.5,84 Z" />
        <!-- arm passing through -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#0C0E14"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M74,28 L30,54 L74,80" />
    </group>
</vector>
